# Load ESP-IDF v6.1 (installed by the ESP-IDF Installation Manager) when entering this folder.
source ~/.espressif/tools/activate_idf_v6.1.sh >/dev/null

# The activate script defines idf.py as a shell function, which direnv cannot
# carry over (it only keeps environment variables), so put it on PATH instead.
PATH_add "$IDF_PATH/tools"
